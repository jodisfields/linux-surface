##
## CachyOS-inspired Performance Optimizations
## Based on https://github.com/CachyOS/linux-cachyos
##

##
## CPU Scheduler: Enable sched-ext for BORE/other schedulers
##
CONFIG_SCHED_CLASS_EXT=y

##
## Kernel Preemption: Full preemption for low-latency desktop
##
CONFIG_PREEMPT=y
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT_COUNT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_DYNAMIC=y

##
## Timer Frequency: 1000Hz for responsive desktop
##
CONFIG_HZ_1000=y
# CONFIG_HZ_300 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_100 is not set
CONFIG_HZ=1000

##
## Tickless kernel (full dynticks for idle + active CPUs)
##
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_COMMON=y
CONFIG_CONTEXT_TRACKING_USER=y

##
## RCU: Boost RCU priority for responsiveness
##
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=0
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_LAZY=y

##
## CPU Compiler Optimizations: Generic x86-64-v3 (modern CPUs: Haswell+)
##
CONFIG_GENERIC_CPU=y

##
## Memory Management: MGLRU (Multi-Generational LRU)
##
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_LRU_GEN_STATS=n

##
## Transparent Hugepages: Always enabled for performance
##
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

##
## ZRAM / ZSWAP for better memory management
##
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y

##
## Network Performance: BBR3 TCP congestion control
##
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_TCP_CONG_CUBIC=m

##
## Network: Additional optimizations
##
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_DEFAULT_NET_SCH="fq"

##
## I/O Scheduler: mq-deadline default (good for NVMe/SSD)
##
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

##
## Block Layer optimizations
##
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

##
## Compiler Optimizations
##
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

##
## Module compression: zstd for best ratio with good speed
##
CONFIG_MODULE_COMPRESS_ZSTD=y
# CONFIG_MODULE_COMPRESS_NONE is not set
# CONFIG_MODULE_COMPRESS_GZIP is not set
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_DECOMPRESS=y

##
## Futex improvements
##
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y

##
## NTSYNC for better Wine/Proton gaming performance
##
CONFIG_NTSYNC=y

##
## Performance Monitoring
##
CONFIG_PERF_EVENTS=y
CONFIG_PERF_EVENTS_AMD_POWER=m
CONFIG_PERF_EVENTS_AMD_UNCORE=m
CONFIG_PERF_EVENTS_INTEL_UNCORE=m
CONFIG_PERF_EVENTS_INTEL_RAPL=m
CONFIG_PERF_EVENTS_INTEL_CSTATE=m

##
## Cgroup v2 (unified hierarchy)
##
CONFIG_CGROUPS=y
CONFIG_CGROUP_V2=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y

##
## PSI (Pressure Stall Information) for better resource monitoring
##
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n

##
## Disable unnecessary debugging for performance
##
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DEBUG_INFO is not set

##
## Disable kernel watchdogs in production
##
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_HARDLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set

##
## Enable user namespaces (needed by many container tools)
##
CONFIG_USER_NS=y

##
## DAMON: Data Access MONitoring for proactive memory management
##
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y

##
## KSM: Kernel Samepage Merging
##
CONFIG_KSM=y

##
## Maple Tree for improved VMA performance (default in 6.x)
##
CONFIG_MAPLE_TREE=y

##
## Enable io_uring for fast async I/O
##
CONFIG_IO_URING=y

##
## NVIDIA and GPU optimizations
##
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y

##
## Power management
##
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y

##
## Crypto: Hardware acceleration
##
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CRC32C_INTEL=y
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_SHA512_SSSE3=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y
CONFIG_CRYPTO_CHACHA20_X86_64=y
CONFIG_CRYPTO_POLY1305_X86_64=y
CONFIG_CRYPTO_BLAKE2S_X86=y

##
## WireGuard VPN built-in
##
CONFIG_WIREGUARD=y

##
## Energy Model for power-aware scheduling
##
CONFIG_ENERGY_MODEL=y
