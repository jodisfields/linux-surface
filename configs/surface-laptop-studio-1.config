##
## Surface Laptop Studio 1 (codename: Kahuna)
## Intel Core i5-11300H / i7-11370H, NVIDIA RTX 3050 Ti (optional)
## 14.4" 2400x1600 120Hz display, Thunderbolt 4, Surface Pen
##

##
## Intel Tiger Lake Platform Support
##
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_PINCTRL_TIGERLAKE=y

##
## Intel GPU (Tiger Lake integrated - Iris Xe)
##
CONFIG_DRM_I915=m
CONFIG_DRM_I915_GVT=y
CONFIG_DRM_I915_REQUEST_TIMEOUT=20000
CONFIG_DRM_I915_FENCE_TIMEOUT=10000
CONFIG_DRM_I915_PREEMPT_TIMEOUT=640
CONFIG_DRM_I915_HEARTBEAT_INTERVAL=2500

##
## NVIDIA dGPU Support (RTX 3050 Ti - GA107M)
## SLS1 uses a custom PCIe-based dGPU hotplug mechanism
##
CONFIG_DRM_NOUVEAU=m
CONFIG_NOUVEAU_LEGACY_CTX_SUPPORT=y
CONFIG_DRM_NOUVEAU_GSP_DEFAULT=y
CONFIG_PCI_HOTPLUG=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y

##
## Surface Hotplug driver (critical for SLS1 dGPU)
## Controls the discrete GPU hotplug via Surface Aggregator Module
##
CONFIG_SURFACE_HOTPLUG=m

##
## Surface Book 1 dGPU switch (shares mechanism with SLS1)
##
CONFIG_SURFACE_BOOK1_DGPU_SWITCH=m

##
## Thunderbolt 4 / USB4 Support
## SLS1 has 2x Thunderbolt 4 (USB-C) ports
##
CONFIG_USB4=m
CONFIG_USB4_DEBUGFS_WRITE=n
CONFIG_USB4_DMA_TEST=m
CONFIG_THUNDERBOLT=m

##
## USB / Type-C Support
##
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_TYPEC_TBT_ALTMODE=m

##
## Touch / Pen Input (IPTS - Intel Precise Touch & Stylus)
## SLS1 uses IPTS for pen and touch input
##
CONFIG_HID_IPTS=m
CONFIG_INTEL_THC_HID=m
CONFIG_INTEL_QUICKSPI=m

##
## HID / Input drivers for SLS1
##
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_GYRO_3D=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_HID_SURFACE=m

##
## Surface Aggregator Module (SAM) - Critical for SLS1
## Manages keyboard, power, fans, dGPU, lid state
##
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_CDEV=m
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m

##
## Surface platform drivers
##
CONFIG_SURFACE_ACPI_NOTIFY=m
CONFIG_SURFACE_DTX=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_KBD=m
CONFIG_SURFACE_GPE=m

##
## Power / Battery / Thermal management
##
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_SENSORS_SURFACE_TEMP=m
CONFIG_SENSORS_SURFACE_FAN=m

##
## Intel thermal management
##
CONFIG_INT340X_THERMAL=m
CONFIG_INTEL_PCH_THERMAL=m
CONFIG_INTEL_TCC_COOLING=m
CONFIG_INTEL_HFI_THERMAL=y
CONFIG_INTEL_POWERCLAMP=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_RAPL=m

##
## Audio: Intel Tiger Lake HD Audio
##
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m

##
## WiFi: Intel AX210 (WiFi 6E)
##
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLWIFI_OPMODE_MODULAR=y

##
## Bluetooth: Intel AX210
##
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m

##
## NVMe storage (SLS1 uses NVMe SSD)
##
CONFIG_BLK_DEV_NVME=m
CONFIG_NVME_CORE=m

##
## Cameras: IPU3 / ISP (front-facing camera)
##
CONFIG_VIDEO_IPU3_IMGU=m
CONFIG_VIDEO_IPU3_CIO2=m
CONFIG_IPU_BRIDGE=m
CONFIG_INTEL_SKL_INT3472=m

##
## Accelerometer / Sensors for tablet mode detection
##
CONFIG_IIO=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_IIO_TRIGGER=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_GYRO_3D=m

##
## Runtime Power Management
##
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_DEBUG=n
CONFIG_ACPI_SLEEP=y

##
## Intel Speed Shift (HWP) for efficient CPU frequency management
##
CONFIG_X86_INTEL_PSTATE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

##
## PCIe power management (important for dGPU power savings)
##
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_DEFAULT=y
CONFIG_PCIE_DPC=y

##
## Firmware: request firmware from userspace
##
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
