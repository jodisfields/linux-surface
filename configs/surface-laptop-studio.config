# Surface Laptop Studio generation 1
# Intel Core i7-11370H, Iris Xe, NVIDIA RTX 3050 Ti, AX200 and NVMe storage.

# Surface Aggregator Module and attached devices.
CONFIG_SURFACE_AGGREGATOR=m
# CONFIG_SURFACE_AGGREGATOR_ERROR_INJECTION is not set
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_CDEV=m
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_TABLET_SWITCH=m
CONFIG_SURFACE_ACPI_NOTIFY=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_KBD=m
CONFIG_BATTERY_SURFACE=m
CONFIG_CHARGER_SURFACE=m
CONFIG_SENSORS_SURFACE_TEMP=m
CONFIG_SENSORS_SURFACE_FAN=m
CONFIG_RTC_DRV_SURFACE=m
CONFIG_HID_SURFACE=m

# Touchscreen and pen. iptsd performs the userspace processing.
CONFIG_HID_IPTS=m
CONFIG_HID_ITHC=m
CONFIG_INTEL_THC_HID=m
CONFIG_INTEL_QUICKSPI=m

# Graphics and IOMMU support for the Intel iGPU and NVIDIA dGPU.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_VFIO=m
CONFIG_PCI_ATS=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y

# Tiger Lake power management, Thunderbolt 4, storage, Wi-Fi and audio.
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y
CONFIG_INTEL_RAPL=m
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_THUNDERBOLT=m
CONFIG_USB4=m
CONFIG_BLK_DEV_NVME=m
CONFIG_NVME_CORE=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_INTEL_SOF_TGL_MATCH=m

# Fedora requires this when the camera patches select V4L2 subdevices.
CONFIG_VIDEO_V4L2_SUBDEV_API=y

# Keep the kernel's NX state authoritative rather than the firmware flag.
# CONFIG_EFI_DXE_MEM_ATTRIBUTES is not set

# CVE-2026-31431 is avoided by removing the userspace AEAD interface.
# CONFIG_CRYPTO_USER_API_AEAD is not set

# CachyOS desktop scheduler and timer settings.
CONFIG_SCHED_BORE=y
CONFIG_MIN_BASE_SLICE_NS=1000000
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y

# Compile for this Tiger Lake CPU rather than portable x86-64.
CONFIG_X86_NATIVE_CPU=y
# CONFIG_GENERIC_CPU is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# CachyOS memory and compressed-swap defaults.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set
CONFIG_THP_SWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_SWAP=y
CONFIG_COMPACTION=y
CONFIG_PSI=y

# Desktop storage and network latency settings.
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_BLK_WBT=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_FQ_CODEL is not set
CONFIG_NET_SCH_FQ_CODEL=y

# Fast compression and gaming-related synchronisation.
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_RD_ZSTD=y
CONFIG_NTSYNC=m
CONFIG_FUTEX_PRIVATE_HASH=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Keep CPU vulnerability and bus-lock mitigations enabled.
CONFIG_CPU_MITIGATIONS=y
