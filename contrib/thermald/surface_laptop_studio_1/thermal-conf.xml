<?xml version="1.0" encoding="UTF-8"?>
<!--
  Thermal configuration for Surface Laptop Studio 1
  Intel Core i5-11300H / i7-11370H with optional NVIDIA RTX 3050 Ti

  This configuration manages thermals for both the CPU and dGPU,
  targeting a balance between performance and quiet fan operation.

  Temperature thresholds are tuned for the SLS1 chassis which has
  limited thermal headroom in tablet/studio mode.
-->
<ThermalConfiguration>
  <Platform>
    <Name>Override</Name>
    <ProductName>Surface Laptop Studio*</ProductName>
    <Preference>PERFORMANCE</Preference>
    <ThermalZones>
      <!-- CPU thermal zone -->
      <ThermalZone>
        <Type>cpu</Type>
        <TripPoints>
          <!-- Initial throttling at 75C -->
          <TripPoint>
            <SensorType>x86_pkg_temp</SensorType>
            <Temperature>75000</Temperature>
            <type>passive</type>
            <CoolingDevice>
              <index>1</index>
              <type>Processor</type>
              <influence>100</influence>
              <SamplingPeriod>4</SamplingPeriod>
              <TargetState>2</TargetState>
            </CoolingDevice>
          </TripPoint>
          <!-- Aggressive throttling at 85C -->
          <TripPoint>
            <SensorType>x86_pkg_temp</SensorType>
            <Temperature>85000</Temperature>
            <type>passive</type>
            <CoolingDevice>
              <index>1</index>
              <type>Processor</type>
              <influence>100</influence>
              <SamplingPeriod>3</SamplingPeriod>
              <TargetState>5</TargetState>
            </CoolingDevice>
          </TripPoint>
          <!-- Maximum throttling at 95C -->
          <TripPoint>
            <SensorType>x86_pkg_temp</SensorType>
            <Temperature>95000</Temperature>
            <type>max</type>
            <CoolingDevice>
              <index>1</index>
              <type>Processor</type>
              <influence>100</influence>
              <SamplingPeriod>2</SamplingPeriod>
              <TargetState>10</TargetState>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
      <!-- Skin temperature zone (palm rest / chassis) -->
      <ThermalZone>
        <Type>skin</Type>
        <TripPoints>
          <TripPoint>
            <SensorType>GEN1</SensorType>
            <Temperature>45000</Temperature>
            <type>passive</type>
            <CoolingDevice>
              <index>1</index>
              <type>Processor</type>
              <influence>80</influence>
              <SamplingPeriod>5</SamplingPeriod>
              <TargetState>3</TargetState>
            </CoolingDevice>
          </TripPoint>
          <TripPoint>
            <SensorType>GEN1</SensorType>
            <Temperature>50000</Temperature>
            <type>max</type>
            <CoolingDevice>
              <index>1</index>
              <type>Processor</type>
              <influence>100</influence>
              <SamplingPeriod>3</SamplingPeriod>
              <TargetState>6</TargetState>
            </CoolingDevice>
          </TripPoint>
        </TripPoints>
      </ThermalZone>
    </ThermalZones>
    <CoolingDevices>
      <CoolingDevice>
        <Type>Processor</Type>
        <MinState>0</MinState>
        <IncDecStep>1</IncDecStep>
        <ReadBack>0</ReadBack>
        <MaxState>10</MaxState>
        <DebouncePeriod>3</DebouncePeriod>
      </CoolingDevice>
    </CoolingDevices>
  </Platform>
</ThermalConfiguration>
