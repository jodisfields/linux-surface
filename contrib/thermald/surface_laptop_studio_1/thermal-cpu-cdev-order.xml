<!--
  Cooling device order for the Microsoft Surface Laptop Studio 1.

  Prefer RAPL (power-limit based) throttling first because it provides
  the smoothest performance scaling on Intel Tiger Lake H35.  Fall back
  to intel_pstate frequency scaling and finally to generic CPU P-state
  control via the cpufreq interface.
-->
<CoolingDeviceOrder>
	<CoolingDevice>rapl_controller</CoolingDevice>
	<CoolingDevice>intel_pstate</CoolingDevice>
	<CoolingDevice>intel_powerclamp</CoolingDevice>
	<CoolingDevice>cpufreq</CoolingDevice>
	<CoolingDevice>Processor</CoolingDevice>
</CoolingDeviceOrder>
