##
## CachyOS-inspired Performance Optimizations for Fedora
##
## These supplement the base options already in surface-6.19.config
## (1000Hz, preempt, THP, BBR, NTSYNC, NO_HZ_FULL, autogroup).
##

##
## sched-ext: Enable extensible scheduler class for BPF schedulers
##
CONFIG_SCHED_CLASS_EXT=y

##
## RCU: Boost priority and lazy callbacks for responsiveness
##
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=0
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_LAZY=y

##
## Memory: MGLRU (Multi-Generational LRU)
##
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

##
## ZSWAP: Compressed swap cache with zstd
##
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSWAP_ZPOOL_DEFAULT_ZSMALLOC=y
CONFIG_ZSMALLOC=y

##
## ZRAM: Compressed RAM block device
##
CONFIG_ZRAM=m

##
## Module compression: zstd
##
CONFIG_MODULE_COMPRESS_ZSTD=y
# CONFIG_MODULE_COMPRESS_NONE is not set
# CONFIG_MODULE_COMPRESS_GZIP is not set
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_DECOMPRESS=y

##
## I/O Schedulers
##
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

##
## DAMON: Data Access MONitoring
##
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_RECLAIM=y
CONFIG_DAMON_LRU_SORT=y

##
## KSM: Kernel Samepage Merging
##
CONFIG_KSM=y

##
## PSI: Pressure Stall Information
##
CONFIG_PSI=y

##
## Crypto: Hardware acceleration
##
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_CRC32C_INTEL=y
CONFIG_CRYPTO_SHA256_SSSE3=y
CONFIG_CRYPTO_SHA512_SSSE3=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y

##
## WireGuard built-in
##
CONFIG_WIREGUARD=y

##
## Power-aware scheduling
##
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y

##
## Disable unnecessary debug overhead for production
##
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
