##
## Surface Laptop Studio 1 Hardware Support
## Intel Core i5-11300H / i7-11370H, NVIDIA RTX 3050 Ti (optional)
##

##
## Intel Tiger Lake Platform
##
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_PINCTRL_TIGERLAKE=y

##
## Intel Iris Xe GPU
##
CONFIG_DRM_I915=m

##
## NVIDIA dGPU (RTX 3050 Ti) via nouveau
##
CONFIG_DRM_NOUVEAU=m

##
## PCIe Hotplug (critical for SLS1 dGPU)
##
CONFIG_PCI_HOTPLUG=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y

##
## Thunderbolt 4 / USB4
##
CONFIG_USB4=m
CONFIG_THUNDERBOLT=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC_DP_ALTMODE=m
CONFIG_TYPEC_TBT_ALTMODE=m

##
## Touch / Pen Input (IPTS)
##
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_SENSOR_HUB=m

##
## Sensors for tablet mode detection
##
CONFIG_IIO=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_IIO_TRIGGER=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_GYRO_3D=m
CONFIG_HID_SENSOR_ALS=m

##
## Intel thermal management
##
CONFIG_INT340X_THERMAL=m
CONFIG_INTEL_PCH_THERMAL=m
CONFIG_INTEL_TCC_COOLING=m
CONFIG_INTEL_POWERCLAMP=m
CONFIG_X86_PKG_TEMP_THERMAL=m
CONFIG_INTEL_RAPL=m

##
## Audio: Intel Tiger Lake HD Audio
##
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m

##
## WiFi: Intel AX210 (WiFi 6E)
##
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m

##
## Bluetooth
##
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m

##
## NVMe
##
CONFIG_BLK_DEV_NVME=m
CONFIG_NVME_CORE=m

##
## PCIe power management
##
CONFIG_PCIEASPM=y

##
## Firmware compression
##
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

##
## Runtime power management
##
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
